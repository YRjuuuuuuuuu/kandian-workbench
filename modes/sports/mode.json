    "topic_profiles": [
      {
        "id": "result_brief",
        "name": "赛事赛果快报",
        "template_id": "result",
        "min_facts": 1,
        "lookback_hours": 12,
        "max_queries": 5,
        "prompt": "采集微博体育热榜、微博热搜和抖音热榜作需求信号，再结合赛程、官方赛果、可靠中文体育媒体和独立赛后报道。热榜没有该赛事时仍查当天赛程，不能把未上榜当作无选题。避开博彩、政治、军事、财经、运动员隐私、场外争议和粉丝冲突。只依据真实材料；发现阶段每题给清晰角度和2—4条核心事实，不为了凑完整技术统计或采访而空转。当天已结束比赛的结果快读。确认北京时间赛事日期、对阵、正式结束状态和最终比分后即可推荐；精确终场钟表时刻、完整技术统计、采访均非必需。只知道日期时标date，event_end_at填null。选最近且受众广的赛事，围绕胜负、关键球员及一项确有来源的表现组织，标题先交代信息。稿件约400—700字，事实不够时短写，不填充虚构转折。"
      },
      {
        "id": "match_analysis",
        "name": "比赛复盘与赛果分析",
        "template_id": "analysis",
        "min_facts": 2,
        "lookback_hours": 18,
        "max_queries": 5,
        "prompt": "采集微博体育热榜、微博热搜和抖音热榜作需求信号，再结合赛程、官方赛果、可靠中文体育媒体和独立赛后报道。热榜没有该赛事时仍查当天赛程，不能把未上榜当作无选题。避开博彩、政治、军事、财经、运动员隐私、场外争议和粉丝冲突。只依据真实材料；发现阶段每题给清晰角度和2—4条核心事实，不为了凑完整技术统计或采访而空转。选择北京时间今天完赛、至少有两项可讨论事实的比赛。围绕一个有依据的问题推荐角度，例如比分走势、阵容调整或公开统计反映的变化。没有回合录像就不写具体战术执行，没有技术统计就以已核实的关键事件与教练公开解释为范围。区分事实和解释。不要强制等官方完整数据或精确终场时刻，约700—1100字。"
      },
      {
        "id": "athlete_analysis",
        "name": "运动员表现分析",
        "template_id": "athlete",
        "min_facts": 2,
        "lookback_hours": 72,
        "max_queries": 5,
        "prompt": "采集微博体育热榜、微博热搜和抖音热榜作需求信号，再结合赛程、官方赛果、可靠中文体育媒体和独立赛后报道。热榜没有该赛事时仍查当天赛程，不能把未上榜当作无选题。避开博彩、政治、军事、财经、运动员隐私、场外争议和粉丝冲突。只依据真实材料；发现阶段每题给清晰角度和2—4条核心事实，不为了凑完整技术统计或采访而空转。选最近三天正在被关注的运动员比赛表现或已公开的竞技变化，允许近七天事实作为背景，但不能包装为今天才发生的赛果。至少两项可追溯的表现事实，评价聚焦能力、角色、选择与适用边界，避免身价、隐私、心理臆测和粉圈立场。呈现一个具体问题、支持证据、其他解释，约800—1200字。"
      },
      {
        "id": "team_analysis",
        "name": "球队与队伍观察",
        "template_id": "team",
        "min_facts": 2,
        "lookback_hours": 72,
        "max_queries": 5,
        "prompt": "采集微博体育热榜、微博热搜和抖音热榜作需求信号，再结合赛程、官方赛果、可靠中文体育媒体和独立赛后报道。热榜没有该赛事时仍查当天赛程，不能把未上榜当作无选题。避开博彩、政治、军事、财经、运动员隐私、场外争议和粉丝冲突。只依据真实材料；发现阶段每题给清晰角度和2—4条核心事实，不为了凑完整技术统计或采访而空转。选最近三天有明确竞技变化的球队或队伍，结合最近七天已核实比赛作比较。观察阵容轮换、比赛节奏、公开统计趋势与后续赛程，不把一场胜负归纳为球队本质，不写转会财务、圈外风波或饭圈冲突。没有可比统计就写有证据的人员职责与比赛事件，约800—1200字。"
      },
      {
        "id": "event_explainer",
        "name": "赛事看点与规则解读",
        "template_id": "rules",
        "min_facts": 2,
        "lookback_hours": 72,
        "max_queries": 5,
        "prompt": "采集微博体育热榜、微博热搜和抖音热榜作需求信号，再结合赛程、官方赛果、可靠中文体育媒体和独立赛后报道。热榜没有该赛事时仍查当天赛程，不能把未上榜当作无选题。避开博彩、政治、军事、财经、运动员隐私、场外争议和粉丝冲突。只依据真实材料；发现阶段每题给清晰角度和2—4条核心事实，不为了凑完整技术统计或采访而空转。选择近期大赛赛制、晋级条件、赛程节点或比赛中出现的规则问题。用当前官方规则和可核实实例回答普通读者最关心的具体问题，明确赛事版本与适用范围。可以是今天热点引出的解释型内容，不强制存在刚结束的比赛。避免竞猜、预测投注和未经证实的裁判指控，约700—1100字。"
      },
      {
        "id": "official_quote",
        "name": "官方及赛后原话解读",
        "template_id": "quote",
        "min_facts": 1,
        "lookback_hours": 24,
        "max_queries": 5,
        "prompt": "采集微博体育热榜、微博热搜和抖音热榜作需求信号，再结合赛程、官方赛果、可靠中文体育媒体和独立赛后报道。热榜没有该赛事时仍查当天赛程，不能把未上榜当作无选题。避开博彩、政治、军事、财经、运动员隐私、场外争议和粉丝冲突。只依据真实材料；发现阶段每题给清晰角度和2—4条核心事实，不为了凑完整技术统计或采访而空转。选择今天真实发生且能核对原文、说话人、场合和上下文的体育言论，优先运动员、教练、联盟官方。短引语与忠实转述结合，保留条件词与否定，不夸大为全体观点。缺少原文时改为其他稿型，不编引语，不让整轮发现因没有采访而无选题。约600—900字。"
      }
